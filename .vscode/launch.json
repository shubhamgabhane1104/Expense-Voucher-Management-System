{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (Express API)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}/server",
      "restart": true,
      "envFile": "${workspaceFolder}/server/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Test Suite",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/test-api.js",
      "cwd": "${workspaceFolder}"
    }
  ]
}
